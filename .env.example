# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use Supabase's direct/session pooler Postgres URL (with SSL).
DATABASE_URL=
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Needle Drop <quiz@your-domain.com>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
STORAGE_BUCKET=quiz-audio
FFMPEG_PATH=ffmpeg
# Optional override; otherwise uses ffprobe alongside FFmpeg or on PATH.
FFPROBE_PATH=
YTDLP_PATH=yt-dlp
# Optional Spotify playlist metadata import. Keep these server-only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# User authorization with playlist-read-private/playlist-read-collaborative where needed.
SPOTIFY_REFRESH_TOKEN=
# Explicitly enable sample data in a production preview only. Leave unset for live use.
ALLOW_DEMO=false
# Optional trusted CA path for Postgres, when not in the system trust store.
PG_CA_FILE=
